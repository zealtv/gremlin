# Per-install state of this gremlin: made by running it, never part of the
# product. /update leaves these alone. Paths are relative to .gremlin/.
.DS_Store
__pycache__/

# identity and model choice
/name
/identity.md
/.model

# running state
/.tending.pid
/.paused
/run.log

# the conversation, and its rotated archives
/transcript.md
/transcript-archive/*
!/transcript-archive/.gitkeep

# generated by doctor from this host's primitives
/PRIMITIVES.md
/context/system/identity.md
/context/system/primitives.md

# bridge runtime
/bridges/*/config
/bridges/*/*.pid
/bridges/*/*.log
/bridges/*/.cursor
/bridges/*/.cache/
/bridges/*/.update-offset
