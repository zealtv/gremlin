#!/bin/sh
if [ "${GREMLIN_BASH_TRAMPOLINE:-}" != "1" ]; then
  [ "${LC_ALL:-}" = "C.UTF-8" ] && unset LC_ALL
  export GREMLIN_BASH_TRAMPOLINE=1
  exec bash "$0" "$@"
fi
unset GREMLIN_BASH_TRAMPOLINE
# gremlin — user-facing entry point.
set -euo pipefail

if [ "${LC_ALL:-}" = "C.UTF-8" ]; then
  unset LC_ALL
fi

GREMLIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$GREMLIN_DIR/bin/run.sh"
LOG="$GREMLIN_DIR/run.log"

usage() {
  cat <<'USAGE'
usage:
  ./.gremlin/gremlin wake                     start the loops
  ./.gremlin/gremlin sleep                    stop them
  ./.gremlin/gremlin status                   awake or asleep?
  ./.gremlin/gremlin restart                  sleep, then wake
  ./.gremlin/gremlin tend                     work the nest once, now
  ./.gremlin/gremlin ask <message|/command>   you -> gremlin, and wait
  ./.gremlin/gremlin tell <message>           gremlin -> you, unprompted
  ./.gremlin/gremlin tui
  ./.gremlin/gremlin <command> [args...]
  ./.gremlin/gremlin <bridge> <verb> [args...]
  ./.gremlin/gremlin help
USAGE
}

# The verbs that were renamed. Kept as explicit refusals rather than aliases,
# for one specific reason: `commands/stop.sh` exists (the /stop slash command
# aborts an in-flight model call), so a removed `stop` would fall through to
# the command dispatcher below and silently do something *different* from what
# muscle memory expects. Fail loud, name the new verb, exit non-zero.
renamed() {
  echo "\`$1\` is now \`$2\`" >&2
  echo "  ./.gremlin/gremlin $2${3:+ $3}" >&2
  exit 2
}

runner_pids() {
  pgrep -f "$RUNNER" 2>/dev/null || true
}

# Who is this? Falls back to a bare noun for a gremlin that predates names or
# whose name.sh is missing — this is chatter, never load-bearing.
gremlin_name() {
  if [ -x "$GREMLIN_DIR/bin/name.sh" ]; then
    "$GREMLIN_DIR/bin/name.sh" 2>/dev/null || echo "this gremlin"
  else
    echo "this gremlin"
  fi
}

cmd_tend() {
  local runner="$GREMLIN_DIR/bin/tend-loop.sh"
  [ -x "$runner" ] || { echo "tend loop not executable: $runner" >&2; exit 1; }
  if [ -n "$(runner_pids)" ]; then
    echo "note: $(gremlin_name) is awake and already tending every few seconds" >&2
  fi
  exec "$runner" "$@"
}

require_runner() {
  [ -x "$RUNNER" ] || {
    echo "runner not executable: $RUNNER" >&2
    exit 1
  }
}

cmd_wake() {
  require_runner
  local pids
  pids="$(runner_pids)"
  if [ -n "$pids" ]; then
    echo "$(gremlin_name) is already awake:"
    printf '%s\n' "$pids"
    exit 1
  fi

  nohup "$RUNNER" >> "$LOG" 2>&1 &
  local pid="$!"
  disown "$pid" 2>/dev/null || true
  echo "$(gremlin_name) is awake: $pid"
  echo "log: $LOG"
}

cmd_status() {
  local pids
  pids="$(runner_pids)"
  if [ -n "$pids" ]; then
    echo "$(gremlin_name) is awake:"
    printf '%s\n' "$pids"
  else
    echo "$(gremlin_name) is asleep"
  fi
}

cmd_sleep() {
  local pids pid deadline
  pids="$(runner_pids)"
  if [ -z "$pids" ]; then
    echo "$(gremlin_name) is already asleep"
    return 0
  fi

  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    kill "$pid" 2>/dev/null || true
  done <<< "$pids"

  deadline=$(( $(date +%s) + 5 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ -z "$(runner_pids)" ] && {
      echo "$(gremlin_name) is asleep"
      return 0
    }
    sleep 0.2
  done

  echo "sent the signal, but the runner still appears active:" >&2
  runner_pids >&2
  exit 1
}

cmd_help() {
  usage
  echo
  echo "built-ins:"
  printf '  %s\n' wake sleep status restart tend ask tell tui help

  echo
  echo "commands:"
  if [ -x "$GREMLIN_DIR/commands/help.sh" ]; then
    "$GREMLIN_DIR/commands/help.sh" | sed 's/^/  /'
  else
    echo "  (none)"
  fi

  echo
  echo "bridges:"
  local found=0 bridge script name
  for bridge in "$GREMLIN_DIR"/bridges/*; do
    [ -d "$bridge" ] || continue
    name="$(basename "$bridge")"
    script="$bridge/$name.sh"
    [ -x "$script" ] || continue
    printf '  %s\n' "$name"
    found=1
  done
  [ "$found" -eq 1 ] || echo "  (none)"
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

verb="$1"
shift

case "$verb" in
  wake)
    cmd_wake "$@"
    ;;
  sleep)
    cmd_sleep "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  restart)
    cmd_sleep
    cmd_wake
    ;;
  tend)
    cmd_tend "$@"
    ;;
  ask)
    exec "$GREMLIN_DIR/bin/say.sh" "$@"
    ;;
  tell)
    exec "$GREMLIN_DIR/bin/tell.sh" "$@"
    ;;
  start)  renamed start wake ;;
  stop)   renamed stop sleep ;;
  say)    renamed say ask "$*" ;;
  tui)
    exec "$GREMLIN_DIR/bridges/tui/tui.sh" "$@"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  *)
    command_script="$GREMLIN_DIR/commands/$verb.sh"
    if [ -x "$command_script" ]; then
      exec "$command_script" "$@"
    fi

    bridge_script="$GREMLIN_DIR/bridges/$verb/$verb.sh"
    if [ -x "$bridge_script" ]; then
      exec "$bridge_script" "$@"
    fi

    echo "unknown gremlin verb: $verb" >&2
    echo "try: ./.gremlin/gremlin help" >&2
    exit 1
    ;;
esac
