#!/bin/sh
if [ "${GREMLIN_BASH_TRAMPOLINE:-}" != "1" ]; then
  [ "${LC_ALL:-}" = "C.UTF-8" ] && unset LC_ALL
  export GREMLIN_BASH_TRAMPOLINE=1
  exec bash "$0" "$@"
fi
unset GREMLIN_BASH_TRAMPOLINE
# gremlin — user-facing entry point.
set -euo pipefail

if [ "${LC_ALL:-}" = "C.UTF-8" ]; then
  unset LC_ALL
fi

GREMLIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$GREMLIN_DIR/bin/run.sh"
LOG="$GREMLIN_DIR/run.log"

usage() {
  cat <<'USAGE'
usage:
  ./.gremlin/gremlin wake                     start the loops
  ./.gremlin/gremlin sleep                    stop them
  ./.gremlin/gremlin status                   awake, asleep, or what is missing
  ./.gremlin/gremlin restart                  sleep, then wake
  ./.gremlin/gremlin tend                     work the nest once, now
  ./.gremlin/gremlin prompt [--read-only] <message>
                                               submit a turn and wait
  ./.gremlin/gremlin tui
  ./.gremlin/gremlin <command> [args...]
  ./.gremlin/gremlin <bridge> <verb> [args...]
  ./.gremlin/gremlin help
USAGE
}

# The verbs that were renamed. Kept as explicit refusals rather than aliases,
# for one specific reason: `commands/stop.sh` exists (the /stop slash command
# aborts an in-flight model call), so a removed `stop` would fall through to
# the command dispatcher below and silently do something *different* from what
# muscle memory expects. Fail loud, name the new verb, exit non-zero.
renamed() {
  echo "\`$1\` is now \`$2\`" >&2
  echo "  ./.gremlin/gremlin $2${3:+ $3}" >&2
  exit 2
}

runner_pids() {
  "$GREMLIN_DIR/bin/runner-pids.sh" 2>/dev/null || true
}

# Who is this? Falls back to a bare noun for a gremlin that predates names or
# whose name.sh is missing — this is chatter, never load-bearing.
gremlin_name() {
  if [ -x "$GREMLIN_DIR/bin/name.sh" ]; then
    "$GREMLIN_DIR/bin/name.sh" 2>/dev/null || echo "this gremlin"
  else
    echo "this gremlin"
  fi
}

cmd_tend() {
  local runner="$GREMLIN_DIR/bin/tend-loop.sh"
  [ -x "$runner" ] || { echo "tend loop not executable: $runner" >&2; exit 1; }
  if [ -n "$(runner_pids)" ]; then
    echo "note: $(gremlin_name) is awake and already tending every few seconds" >&2
  fi
  exec "$runner" "$@"
}

require_runner() {
  [ -x "$RUNNER" ] || {
    echo "runner not executable: $RUNNER" >&2
    exit 1
  }
}

cmd_wake() {
  require_runner
  "$GREMLIN_DIR/bin/require-nest.sh" || exit 1
  local pids
  pids="$(runner_pids)"
  if [ -n "$pids" ]; then
    echo "$(gremlin_name) is already awake:"
    printf '%s\n' "$pids"
    exit 1
  fi

  nohup "$RUNNER" >> "$LOG" 2>&1 &
  local pid="$!"
  disown "$pid" 2>/dev/null || true
  echo "$(gremlin_name) is awake: $pid"
  echo "log: $LOG"
}

# runner_parts: what the process table shows of the runner, from one snapshot,
# one part per line: `supervisor <pid>`, `tend <pid>`, `tick <pid>`, `unsure
# <pid>` (a lone loop that can't be told apart just now) or `stray <pid>` (a
# runner process with no supervisor). Nothing if no runner process lives.
# The loops are the supervisor's children, told apart by what each runs or
# sleeps in: the tend loop runs tend-loop.sh or naps `sleep 5`; the tick loop
# runs tick-loop.sh or moot-loop.sh, or naps until the next minute. When both
# nap `sleep 5` (the minute's last seconds), the lower pid is the tend loop,
# which run.sh forked first. Reads the process table only; never calls a model.
runner_parts() {
  COLUMNS= ps -A -o pid= -o ppid= -o args= | awk -v set="$(runner_pids | tr '\n' ' ')" '
    BEGIN { n = split(set, a, " "); for (i = 1; i <= n; i++) inrun[a[i]] = 1 }
    {
      pid = $1; ppid[pid] = $2; order[++np] = pid
      c = $0; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+/, "", c); cmd[pid] = c
    }
    END {
      for (i = 1; i <= np; i++) {            # a fork of a runner process (same command line) is a loop; a wrapper is not
        p = order[i]
        if (!(p in inrun)) continue
        if ((ppid[p] in inrun) && cmd[ppid[p]] == cmd[p]) kids[ppid[p]]++; else roots[++nr] = p
      }
      sup = ""
      for (i = 1; i <= nr; i++)
        if ((roots[i] in kids) && (sup == "" || roots[i] + 0 < sup + 0)) sup = roots[i]
      for (i = 1; i <= nr; i++) if (roots[i] != sup) print "stray", roots[i]
      if (sup == "") exit
      print "supervisor", sup
      nl = 0
      for (i = 1; i <= np; i++) {
        p = order[i]
        if ((p in inrun) && ppid[p] == sup && cmd[p] == cmd[sup]) loops[++nl] = p
      }
      for (l = 1; l <= nl; l++) {
        kind[l] = ""
        for (i = 1; i <= np; i++) {
          c = order[i]
          if (ppid[c] != loops[l]) continue
          if (cmd[c] ~ /tend-loop\.sh/) kind[l] = "tend"
          else if (cmd[c] ~ /(tick|moot)-loop\.sh/) kind[l] = "tick"
          else if (cmd[c] ~ /^sleep /) { split(cmd[c], w, " "); kind[l] = (w[2] == 5) ? "tend" : "tick" }
        }
      }
      if (nl == 2) {                          # fill in one unseen loop, or fall back to fork order
        lo = (loops[1] + 0 < loops[2] + 0) ? 1 : 2; hi = 3 - lo
        if ((kind[lo] == "" && kind[hi] == "") || kind[lo] == kind[hi]) { kind[lo] = "tend"; kind[hi] = "tick" }
        else if (kind[lo] == "") kind[lo] = (kind[hi] == "tend") ? "tick" : "tend"
        else if (kind[hi] == "") kind[hi] = (kind[lo] == "tend") ? "tick" : "tend"
      }
      for (l = 1; l <= nl; l++) print (kind[l] == "" ? "unsure" : kind[l]), loops[l]
    }'
}

# part_pid <part> <runner_parts output>: the pid of that part, or nothing.
part_pid() { printf '%s\n' "$2" | awk -v k="$1" '$1 == k { print $2; exit }'; }

# status: names the supervisor and each loop with its pid. "awake" only when
# the supervisor and both loops live; otherwise it says what is missing and how
# to bring it back (a dead tend loop under a live supervisor and tick loop once
# read as awake). Always exits 0: the words are the answer.
cmd_status() {
  local parts tries=0 sup tend tick stray missing="" seen="" name
  name="$(gremlin_name)"
  while :; do
    if ! parts="$(runner_parts 2>/dev/null)"; then
      echo "gremlin: ps failed, so I can't say whether $name is awake (status reads the process table)" >&2
      return 1
    fi
    # A lone loop that shows no sleep or pass just now may be either: look again.
    case "$parts" in *unsure*) ;; *) break ;; esac
    tries=$((tries + 1))
    [ "$tries" -ge 5 ] && break
    sleep 0.2
  done
  if [ -z "$parts" ]; then
    echo "$name is asleep"
    return 0
  fi
  sup="$(part_pid supervisor "$parts")"
  tend="$(part_pid tend "$parts")"
  tick="$(part_pid tick "$parts")"
  stray="$(printf '%s\n' "$parts" | awk '$1 == "stray" { printf "%s ", $2 }')"
  if [ -n "$sup" ] && [ -n "$tend" ] && [ -n "$tick" ]; then
    # One write, so a caller's `status | grep -q` can't end it with a SIGPIPE.
    printf '%s is awake:\n  supervisor  %s\n  tend loop   %s\n  tick loop   %s\n' "$name" "$sup" "$tend" "$tick"
    return 0
  fi
  [ -n "$sup" ] && seen="supervisor $sup"
  [ -n "$tend" ] && seen="${seen:+$seen, }tend loop $tend"
  [ -n "$tick" ] && seen="${seen:+$seen, }tick loop $tick"
  [ -n "$stray" ] && seen="${seen:+$seen, }loop(s) with no supervisor: ${stray% }"
  if [ -z "$sup" ]; then
    missing="no supervisor"
  elif printf '%s\n' "$parts" | grep -q '^unsure'; then
    missing="one loop is missing, and the other can't be told apart just now"
  else
    [ -n "$tend" ] || missing="no tend loop"
    [ -n "$tick" ] || missing="${missing:+$missing, }no tick loop"
  fi
  printf '%s is only partly running: %s%s\n  ./.gremlin/gremlin restart brings it back (just woke? ask again in a moment)\n' \
    "$name" "$missing" "${seen:+ (seen: $seen)}"
}

cmd_sleep() {
  local pids pid deadline
  pids="$(runner_pids)"
  if [ -z "$pids" ]; then
    echo "$(gremlin_name) is already asleep"
    return 0
  fi

  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    kill "$pid" 2>/dev/null || true
  done <<< "$pids"

  deadline=$(( $(date +%s) + 5 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ -z "$(runner_pids)" ] && {
      echo "$(gremlin_name) is asleep"
      return 0
    }
    sleep 0.2
  done

  echo "sent the signal, but the runner still appears active:" >&2
  runner_pids >&2
  exit 1
}

cmd_help() {
  usage
  echo
  echo "built-ins:"
  printf '  %s\n' wake sleep status restart tend prompt tui help

  echo
  echo "commands:"
  if [ -x "$GREMLIN_DIR/commands/help.sh" ]; then
    "$GREMLIN_DIR/commands/help.sh" | sed 's/^/  /'
  else
    echo "  (none)"
  fi

  echo
  echo "bridges:"
  local found=0 bridge script name
  for bridge in "$GREMLIN_DIR"/bridges/*; do
    [ -d "$bridge" ] || continue
    name="$(basename "$bridge")"
    script="$bridge/$name.sh"
    [ -x "$script" ] || continue
    printf '  %s\n' "$name"
    found=1
  done
  [ "$found" -eq 1 ] || echo "  (none)"
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

verb="$1"
shift

case "$verb" in
  wake)
    cmd_wake "$@"
    ;;
  sleep)
    cmd_sleep "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  restart)
    cmd_sleep
    cmd_wake
    ;;
  tend)
    cmd_tend "$@"
    ;;
  prompt)
    exec "$GREMLIN_DIR/bin/prompt.sh" "$@"
    ;;
  start)  renamed start wake ;;
  stop)   renamed stop sleep ;;
  say)    renamed say prompt "$*" ;;
  ask)    renamed ask prompt "$*" ;;
  tell)   renamed tell prompt "$*" ;;
  tui)
    exec "$GREMLIN_DIR/bridges/tui/tui.sh" "$@"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  *)
    command_script="$GREMLIN_DIR/commands/$verb.sh"
    if [ -x "$command_script" ]; then
      exec "$command_script" "$@"
    fi

    bridge_script="$GREMLIN_DIR/bridges/$verb/$verb.sh"
    if [ -x "$bridge_script" ]; then
      exec "$bridge_script" "$@"
    fi

    echo "unknown gremlin verb: $verb" >&2
    echo "try: ./.gremlin/gremlin help" >&2
    exit 1
    ;;
esac
